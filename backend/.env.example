# ============================================================
# AI CDSS BACKEND — LOCAL DEVELOPMENT TEMPLATE
#
# Copy this file to backend/.env and replace placeholders locally.
#
# NEVER COMMIT backend/.env
# NEVER STORE PHI OR REAL PATIENT DATA IN NEON FREE.
# NEVER IMPORT backend/data_terstruktur/* INTO NEON FREE.
# ============================================================

# ------------------------------------------------------------
# APPLICATION MODE
# Valid: clinical_sandbox, controlled_pilot, production
# ------------------------------------------------------------
APP_MODE=clinical_sandbox

# ------------------------------------------------------------
# LOCAL API AUTHENTICATION
# Replace placeholders locally with strong random values.
# In clinical_sandbox mode, default sandbox keys are used if unset.
# ------------------------------------------------------------
CDSS_API_KEYS=<LOCAL_ONLY_RANDOM_API_KEY>
CDSS_SECRET_KEY=<LOCAL_ONLY_RANDOM_SERVER_SECRET>

# ------------------------------------------------------------
# PHASE 8 REGISTRY DURABLE STORE
#
# Runtime application URL:
#   use the Neon pooled PostgreSQL URL.
#
# Migration/admin URL:
#   use the Neon direct PostgreSQL URL when available.
#
# Keep activation false during P8-BE governance work.
# Activation requires: approved release with release-level
# approval artifact, complete framework family, and operator
# explicitly setting REGISTRY_ACTIVATION_ENABLED=true.
# ------------------------------------------------------------
REGISTRY_STORE_BACKEND=disabled
REGISTRY_DATABASE_URL=<NEON_POOLED_POSTGRES_CONNECTION_STRING>
REGISTRY_DATABASE_ADMIN_URL=<OPTIONAL_NEON_DIRECT_POSTGRES_CONNECTION_STRING>
REGISTRY_RUNTIME_MODE=synthetic_governance_test
REGISTRY_ACTIVATION_ENABLED=false
REGISTRY_DATABASE_CONNECT_TIMEOUT_SEC=15
REGISTRY_DATABASE_MAX_RETRIES=3
REGISTRY_DATABASE_RETRY_BACKOFF_MS=750

# P8-BE: Bounded startup probe parameters (fail-closed defaults).
# Probe runs at module load; does not auto-migrate or auto-import.
REGISTRY_STARTUP_MAX_ATTEMPTS=3
REGISTRY_STARTUP_CONNECT_TIMEOUT_SEC=15
REGISTRY_STARTUP_BACKOFF_SEC=2

# ------------------------------------------------------------
# PHASE 9 RAG CORPUS FOUNDATION
#
# P9-A creates schema and safe probes only. All RAG behavior is
# disabled by default. synthetic_corpus_test is local-sandbox only
# and requires REGISTRY_ACTIVATION_ENABLED=false.
# ------------------------------------------------------------
RAG_RUNTIME_MODE=disabled
RAG_STORE_ENABLED=false
RAG_INGESTION_ENABLED=false
RAG_LEXICAL_RETRIEVAL_ENABLED=false
RAG_VECTOR_RETRIEVAL_ENABLED=false
RAG_INDEX_ACTIVATION_ENABLED=false
RAG_EXTERNAL_EMBEDDING_PROVIDER_ENABLED=false
RAG_SYNTHETIC_FIXTURE_ROOT=
RAG_MAX_DOCUMENT_CHARS=12000
RAG_MAX_STAGING_CHUNKS=200
RAG_CHUNK_TARGET_WORDS=90
RAG_CHUNK_OVERLAP_WORDS=12
RAG_MAX_RESULTS=5
RAG_MAX_EXCERPT_CHARS=360
RAG_MIN_LEXICAL_RANK=0.01
RAG_MAX_SELECTED_CHUNK_IDS=8
RAG_STAGING_TTL_SECONDS=3600

# ------------------------------------------------------------
# PHASE 10 P10-A1 GOVERNED CORPUS INTAKE AND QUARANTINE
# ------------------------------------------------------------
RAG_CORPUS_INTAKE_ENABLED=false
RAG_CORPUS_QUARANTINE_ENABLED=false
RAG_BODY_STORAGE_ENABLED=false
RAG_REAL_CORPUS_INGESTION_ENABLED=false
RAG_CORPUS_PROMOTION_ENABLED=false
RAG_QUARANTINE_METADATA_TTL_HOURS=24

# ------------------------------------------------------------
# EXTERNAL OR UNSAFE PRODUCT CAPABILITIES
# KEEP DISABLED DURING PHASE 9 RAG FOUNDATION WORK.
# ------------------------------------------------------------
FEATURE_EXTERNAL_LLM=false
FEATURE_EBP_EXTERNAL_SEARCH=false
FEATURE_CLINICAL_PHOTO_ANALYSIS=false
FEATURE_MERMAID_PATHWAY_RENDERING=false
HARVEST_INTERVAL_SEC=0

# ------------------------------------------------------------
# SYNTHETIC SHOWCASE FLAGS
# KEEP DISABLED ON PRODUCT DEVELOPMENT BRANCH.
# ------------------------------------------------------------
SYNTHETIC_LAB_MODE=false
SYNTHETIC_DATA_ONLY=false

# ------------------------------------------------------------
# LOCAL AUDIT LEDGER
# Replace the HMAC placeholder locally.
# Never commit the real HMAC secret or runtime ledger.
# ------------------------------------------------------------
AUDIT_LEDGER_HMAC_KEY=<LOCAL_ONLY_RANDOM_AUDIT_LEDGER_SECRET>
AUDIT_LEDGER_KEY_ID=audit-ledger-local-v1
AUDIT_LEDGER_PATH=backend/audit_ledger.jsonl

# ------------------------------------------------------------
# SESSIONS
# TTL and idle timeouts in seconds.
# ------------------------------------------------------------
SESSION_TTL_SEC=3600
SESSION_IDLE_TIMEOUT_SEC=900
SESSION_MAX_ACTIVE=1000

# ------------------------------------------------------------
# MFA AND DIRECTOR PROVISIONING
# Director bootstrap is a one-time TOTP provisioning secret.
# Never commit the real value.
# ------------------------------------------------------------
MFA_FAILURE_LIMIT=5
MFA_FAILURE_WINDOW_SEC=300
MFA_LOCKOUT_SEC=300
DIRECTOR_BOOTSTRAP=<LOCAL_ONLY_DIRECTOR_BOOTSTRAP_SECRET>
DIRECTOR_ENROLLMENT_ENABLED=false

# ------------------------------------------------------------
# RATE LIMITING
# Window in seconds; max_keys bounds internal tracking structures.
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_KEYS=2048

# ------------------------------------------------------------
# TRUSTED PROXY AND CORS
# Comma-separated values.
# Wildcard CORS origins only allowed in clinical_sandbox.
# ------------------------------------------------------------
TRUSTED_PROXY_HOSTS=
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# UPLOAD PARSER LIMITS
# Bounds for sandbox document parsing.
# ------------------------------------------------------------
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILENAME_LENGTH=180
UPLOAD_MAX_EXTRACTED_CHARS=50000
UPLOAD_MAX_PDF_PAGES=30
UPLOAD_MAX_DOCX_ENTRIES=100
UPLOAD_MAX_DOCX_TOTAL_UNCOMPRESSED_BYTES=5242880
UPLOAD_MAX_DOCX_SINGLE_ENTRY_UNCOMPRESSED_BYTES=2097152
UPLOAD_MAX_DOCX_COMPRESSION_RATIO=100.0
UPLOAD_PARSER_TIMEOUT_SEC=20
UPLOAD_MAX_PARSER_RESULT_BYTES=102400

# ------------------------------------------------------------
# OUTBOUND POLICY AND EBP
# Unpaywall email for EBP literature search.
# Keep ShopeeAI base URL default unless overriding.
# ------------------------------------------------------------
UNPAYWALL_EMAIL=cdss.keperawatan@example.com
SHOPEE_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------
# HARVEST TOPICS
# Comma-separated background literature search topics.
# Keep interval at 0 to disable harvester.
# ------------------------------------------------------------
HARVEST_TOPICS=nursing care,clinical nursing,evidence based nursing

# ------------------------------------------------------------
# UNSAFE LOCAL DEBUG
# Only valid in clinical_sandbox mode.
# Enables external LLM calls for local development.
# NEVER enable in controlled_pilot or production.
# ------------------------------------------------------------
ALLOW_UNSAFE_EXTERNAL_LLM_FOR_LOCAL_DEBUG=false
